# MortMortgage environment reference (task-045 — §7.1: every variable, its
# purpose, default, and whether it is required). Copy to `.env` and fill in.
# SECRETS ARE NEVER COMMITTED — `.env` is gitignored and excluded from Docker
# build contexts; this example file contains placeholders only.

# =============================================================================
# Core (required)
# =============================================================================

# PostgreSQL connection string used by Prisma and the application. REQUIRED.
# With the bundled docker-compose.yml from the HOST: postgresql://postgres:postgres@localhost:5433/mortgage_v3
# (compose maps Postgres to host port 5433; inside the compose network the app uses db:5432)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/mortgage_v3"

# Demonstration mode. Default: false (OFF).
# true  => demo quick-login buttons/endpoints, demonstration attestation, and
#          demo seeding are enabled, and `npm run db:setup` seeds the full
#          demonstration dataset.
# false => all demo-only surfaces are absent (production posture).
# MUST REMAIN false IN PRODUCTION (§7.1; see DEPLOYMENT.md).
DEMO_MODE=false

# =============================================================================
# Object storage (§6.2 row 11)
# =============================================================================

# Storage driver: "local" (default — local disk, development) or "s3"
# (any S3-compatible endpoint: AWS S3, MinIO, ...; required for cloud, §7.1).
# With "s3", ALL S3_* variables below are REQUIRED — the app and worker fail
# fast at startup naming any missing variable (§6.1).
STORAGE_PROVIDER=local

# local provider only — directory for uploaded documents. Default: ./storage.
# Relative paths resolve against the project root. Must be writable by the app
# process; GET /api/health reports "storage": "fail" when it is not.
STORAGE_DIR=./storage

# s3 provider only (required when STORAGE_PROVIDER=s3, ignored otherwise):
# S3_ENDPOINT           Base URL of the S3-compatible API (AWS: https://s3.us-east-1.amazonaws.com, MinIO: http://localhost:9000)
# S3_REGION             Signing region (SigV4), e.g. us-east-1
# S3_BUCKET             Bucket for document objects (bootstrap: npm run storage:init)
# S3_ACCESS_KEY_ID      Access key id (secret — never commit)
# S3_SECRET_ACCESS_KEY  Secret access key (secret — never commit)
# S3_FORCE_PATH_STYLE   "true" for path-style URLs (MinIO and most emulators). Default: false (virtual-hosted, AWS)
#S3_ENDPOINT=http://localhost:9000
#S3_REGION=us-east-1
#S3_BUCKET=mortmortgage-documents
#S3_ACCESS_KEY_ID=<access key>
#S3_SECRET_ACCESS_KEY=<secret key>
#S3_FORCE_PATH_STYLE=true

# =============================================================================
# Cryptographic material (required — generate per environment, never commit)
# =============================================================================

# Key ring for AES-256-GCM field encryption (NFR-002, AC-54): keyId -> base64
# 32-byte key. JSON object ({"k1":"<base64key>"}) or comma list
# (k1:<base64key>,k2:<base64key>). REQUIRED.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Old keys stay in the ring during rotation so existing ciphertext still
# decrypts — see src/lib/crypto/KEY-ROTATION.md and scripts/rotate-keys.ts.
FIELD_ENCRYPTION_KEYS={"k1":"<base64 32-byte key>"}

# keyId (from FIELD_ENCRYPTION_KEYS) used for all NEW encryption. REQUIRED.
FIELD_ENCRYPTION_ACTIVE_KEY_ID=k1

# HMAC-SHA256 key (base64, >= 32 bytes) for the SSN blind index (duplicate
# detection). REQUIRED. Independent of the AES key ring; rotating it requires
# re-deriving all blind indexes.
SSN_BLIND_INDEX_KEY=<base64 32-byte key>

# Session-bound CSRF token HMAC secret (SEC-3). REQUIRED in production
# (falls back to SESSION_SECRET when set). Generate like the keys above.
CSRF_SECRET="replace-with-random-base64-32-bytes"

# Optional shared fallback secret: used for CSRF when CSRF_SECRET is unset and
# for hand-off tokens when HANDOFF_TOKEN_SECRET is unset. Default: unset.
#SESSION_SECRET=

# Optional dedicated HMAC secret for public-tool pre-fill hand-off tokens
# (§4.9). Default: falls back to CSRF_SECRET (then SESSION_SECRET).
#HANDOFF_TOKEN_SECRET=

# =============================================================================
# Web app
# =============================================================================

# Base URL embedded in verification/reset links recorded on the Outbound
# Messages page. REQUIRED. Local dev: http://localhost:3083; compose: http://localhost:3085.
APP_BASE_URL=http://localhost:3083

# Trust proxy-supplied client IP headers (x-forwarded-for) — "true" ONLY when
# the app sits behind a configured proxy/load balancer (§4.1.7); when false
# (default) header-supplied IPs are ignored for sessions/audit records and the
# rate limiter's client-IP bucket dimension is skipped (INV-042).
TRUST_PROXY=false

# Number of TRUSTED proxy hops in front of the app. Each trusted proxy APPENDS
# the address that connected to it to x-forwarded-for, so the real client IP is
# the entry this many positions from the RIGHT — never the leftmost entry, which
# the original caller controls and can forge on every request (INV-042). Set it
# to the number of proxies you actually operate: 1 for a single load balancer
# (default), 2 for CDN + load balancer, and so on. A header with fewer entries
# than this yields no client IP at all. Ignored when TRUST_PROXY=false.
TRUST_PROXY_HOP_COUNT=1

# =============================================================================
# Background worker (npm run worker / compose worker service)
# =============================================================================

# Polling interval for the durable job loop (ms). Default: 20000. Range 1000-3600000.
#WORKER_POLL_INTERVAL_MS=20000

# Windows-only development seam: "true" lets the worker shut down gracefully on
# a stdin "shutdown" line / EOF (Windows cannot deliver a catchable SIGTERM).
# Default: false. Never needed in containers — they use real SIGTERM.
#WORKER_STDIN_SHUTDOWN=false

# =============================================================================
# Integration providers (§6.1/§6.2 — default: built-in deterministic
# simulations, ZERO external keys; all optional)
# =============================================================================

# Underwriting checks: "simulation" (default) or "real". A real provider
# additionally REQUIRES CHECK_PROVIDER_<X>_BASE_URL and CHECK_PROVIDER_<X>_API_KEY
# (startup fails fast naming missing variables). CHECK_PROVIDER_AUS=real is
# rejected — no real AUS provider exists in this version (§6.2 row 9).
#CHECK_PROVIDER_CREDIT=simulation
#CHECK_PROVIDER_INCOME=simulation
#CHECK_PROVIDER_AVM=simulation
#CHECK_PROVIDER_PRICING=simulation
#CHECK_PROVIDER_AUS=simulation

# Per-integration real-provider credentials. Read only when the matching
# CHECK_PROVIDER_<X>=real; unset (and ignored) in the default simulation mode.
# API keys are secrets — never commit real values.
#CHECK_PROVIDER_CREDIT_BASE_URL=
#CHECK_PROVIDER_CREDIT_API_KEY=
#CHECK_PROVIDER_INCOME_BASE_URL=
#CHECK_PROVIDER_INCOME_API_KEY=
#CHECK_PROVIDER_AVM_BASE_URL=
#CHECK_PROVIDER_AVM_API_KEY=
#CHECK_PROVIDER_PRICING_BASE_URL=
#CHECK_PROVIDER_PRICING_API_KEY=
# The AUS pair exists only for symmetry with the other four integrations —
# CHECK_PROVIDER_AUS=real is rejected at startup, so these are never read.
#CHECK_PROVIDER_AUS_BASE_URL=
#CHECK_PROVIDER_AUS_API_KEY=

# Document OCR: "simulation" (default) or "real" (same fail-fast rule). The
# real backend has a kind sub-selector (CH-025 / INT-023):
#   OCR_PROVIDER_KIND=http   (default) requires OCR_PROVIDER_BASE_URL and
#                            OCR_PROVIDER_API_KEY (the pre-CH-025 rule, unchanged)
#   OCR_PROVIDER_KIND=claude (Claude-Vision backend) requires
#                            OCR_PROVIDER_API_KEY only
# The real slot fails soft/retryable until its adapter body is wired (Layer B).
#OCR_PROVIDER=simulation
#OCR_PROVIDER_KIND=http
#OCR_PROVIDER_BASE_URL=
#OCR_PROVIDER_API_KEY=

# Address type-ahead suggestions (CH-025 / INT-023): "simulation" (default —
# the bundled dataset, zero-key) or "real" (Google Places suggest; REQUIRES
# GOOGLE_PLACES_API_KEY — startup fails fast naming it). SUGGEST ONLY: the
# deterministic geocoder feeding AVM/HMDA/subject-property values takes no
# provider branch in either mode (INV-052). Any real-provider fault degrades
# silently to an empty suggestion list. The real slot returns [] until its
# adapter body is wired (Layer B). API keys are secrets — never commit values.
#ADDRESS_PROVIDER=simulation
#GOOGLE_PLACES_API_KEY=

# Bank aggregation token flow (CH-025 / INT-023): "simulation" (default — the
# built-in institution-picker + credentials simulation, zero-key) or "real"
# (Plaid Link token flow; REQUIRES PLAID_CLIENT_ID, PLAID_SECRET, and PLAID_ENV
# — startup fails fast naming the missing variables). Real mode additionally:
#   - admits https://cdn.plaid.com in the CSP script-src/frame-src (INV-053;
#     the default CSP is byte-identical to the delivered posture), and
#   - enables POST /api/applications/:id/bank-links/link-token and .../exchange
#     (503 not-available under simulation) plus the Link-widget borrower UI.
# The real slot returns a retryable 503 until its adapter body is wired
# (Layer B). Secrets — never commit real values.
#BANK_PROVIDER=simulation
#PLAID_CLIENT_ID=
#PLAID_SECRET=
#PLAID_ENV=

# Reporting-only selectors (pre-CH-025) for the GET /api/admin/system-status
# integration labels on the Supervisor system page: "real" => reported as real,
# anything else (default unset) => reported as simulated. Setting these does
# NOT change behaviour — they are labels only. Note: the BEHAVIORAL selectors
# for bank aggregation and address suggest are BANK_PROVIDER and
# ADDRESS_PROVIDER above (CH-025); a keyed deployment that enables a real
# provider should set the matching reporting selector too so the system page
# label agrees. Email/SMS has no real-provider seam in this version.
#BANK_AGGREGATOR_PROVIDER=simulation
#GEOCODING_PROVIDER=simulation
#MESSAGING_PROVIDER=simulation

# Configured fault scenarios for the simulations (§6.3). Default for every one
# of them is "none"; an unrecognised value degrades to "none".
# Underwriting checks accept the full set:
#   none (default) | slow | timeout | unavailable | partial | invalid
#SIM_FAULT_CREDIT=none
#SIM_FAULT_INCOME=none
#SIM_FAULT_AVM=none
#SIM_FAULT_PRICING=none
#SIM_FAULT_AUS=none
# Document OCR accepts the full set as well:
#SIM_FAULT_OCR=none
# Bank link accepts only: none (default) | slow
#SIM_FAULT_BANKLINK=none
# Address geocoding accepts: none (default) | slow | timeout | unavailable
#SIM_FAULT_ADDRESS=none

# =============================================================================
# Simulated-integration latency tuning (§6.3 — optional; every value has a
# code default, so leave these unset unless a demo needs different timing)
# =============================================================================

# Each simulated integration draws a deterministic latency of BASE_MS ± JITTER_MS
# (the jitter offset is seeded from the request input, so the same input always
# yields the same delay). SLOW_EXTRA_MS is added on top when that integration's
# slow fault is selected. All values are milliseconds; a non-numeric or negative
# value falls back to the default shown.

# Underwriting checks (src/lib/services/checks/simulated.ts)
#SIM_LATENCY_CREDIT_BASE_MS=1200
#SIM_LATENCY_CREDIT_JITTER_MS=600
#SIM_LATENCY_CREDIT_SLOW_EXTRA_MS=8000
#SIM_LATENCY_INCOME_BASE_MS=900
#SIM_LATENCY_INCOME_JITTER_MS=400
#SIM_LATENCY_INCOME_SLOW_EXTRA_MS=8000
#SIM_LATENCY_AVM_BASE_MS=1500
#SIM_LATENCY_AVM_JITTER_MS=500
#SIM_LATENCY_AVM_SLOW_EXTRA_MS=8000
#SIM_LATENCY_PRICING_BASE_MS=700
#SIM_LATENCY_PRICING_JITTER_MS=300
#SIM_LATENCY_PRICING_SLOW_EXTRA_MS=8000
#SIM_LATENCY_AUS_BASE_MS=2500
#SIM_LATENCY_AUS_JITTER_MS=500
#SIM_LATENCY_AUS_SLOW_EXTRA_MS=8000

# Bank-link credential exchange (src/lib/services/bank-aggregator.ts). The
# slow-extra also applies to the demo password trigger, not only SIM_FAULT_BANKLINK.
#SIM_LATENCY_BANKLINK_BASE_MS=2000
#SIM_LATENCY_BANKLINK_JITTER_MS=800
#SIM_LATENCY_BANKLINK_SLOW_EXTRA_MS=8000

# Address type-ahead suggestions (src/lib/services/geocoding.ts)
#SIM_LATENCY_ADDRESS_BASE_MS=150
#SIM_LATENCY_ADDRESS_JITTER_MS=100
#SIM_LATENCY_ADDRESS_SLOW_EXTRA_MS=2000

# =============================================================================
# Build/tooling (rarely set by hand)
# =============================================================================

# Next.js build directory override — ONLY for running a second dev/test
# instance on the same working copy (each instance needs its own dist dir).
# Default: .next. Production deployments never set this.
#NEXT_DIST_DIR=.next-secondary

# Set to "1" by the Dockerfile builder stage to produce the self-contained
# .next/standalone server. Not used at runtime. Default: unset.
#NEXT_OUTPUT_STANDALONE=1

# Container runtime (Dockerfile defaults — override only when re-mapping):
# PORT (default 3083) and HOSTNAME (default 0.0.0.0) for the standalone server.
#PORT=3083
#HOSTNAME=0.0.0.0

# Base URL the Playwright end-to-end suite drives (playwright.config.ts, run via
# `npm run test:e2e`). The suite never starts a server — point this at an
# already-running instance. Default: http://localhost:3083.
#E2E_BASE_URL=http://localhost:3083

# =============================================================================
# docker-compose interpolation only (not read by the app itself)
# =============================================================================

# DB_NAME               Database name for the compose Postgres. Default: mortgage_v3
# MINIO_ROOT_USER       MinIO credentials for the local storage emulator.
# MINIO_ROOT_PASSWORD   Defaults: minioadmin/minioadmin (LOCAL EMULATOR ONLY —
#                       real S3 credentials come from your cloud provider).
# COMPOSE_APP_BASE_URL  APP_BASE_URL inside the compose app. Default: http://localhost:3085
#DB_NAME=mortgage_v3
#MINIO_ROOT_USER=minioadmin
#MINIO_ROOT_PASSWORD=minioadmin
#COMPOSE_APP_BASE_URL=http://localhost:3085
